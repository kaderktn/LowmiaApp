<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LowmiaApp.ProfilePage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FDF0F3" Offset="0.0" />
            <GradientStop Color="#FCF5E3" Offset="0.3" />
            <GradientStop Color="#FDF3E8" Offset="0.7" />
            <GradientStop Color="#F9F5FD" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,40,20,30" Spacing="20">


                <!-- ÜST BAR -->
                <Grid ColumnDefinitions="Auto, *" Margin="0,0,0,20">

                    <!-- Tıklama sorunu yaşamamak için özel tasarımlı Button kullanıyoruz -->
                    <Button Grid.Column="0" 
                Text="← Geri" 
                TextColor="#C4962B" 
                BackgroundColor="#FFFFFF" 
                FontSize="15" 
                FontAttributes="Bold"
                CornerRadius="20"
                BorderColor="#E5E2DA"
                BorderWidth="1"
                Padding="15,5"
                HorizontalOptions="Start" 
                VerticalOptions="Center"
                Clicked="OnBackClicked" />

                    <Label Grid.Column="1" 
               Text="HESAP BİLGİLERİ" 
               FontSize="20" 
               TextColor="#C4962B" 
               HorizontalOptions="Center" 
               VerticalOptions="Center" 
               CharacterSpacing="2" />
                </Grid>

                <!-- BİLGİ GÜNCELLEME KARTI -->
                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#D4AF37" Opacity="0.05" Radius="15" Offset="0,5"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Kişisel Bilgiler" FontSize="14" FontAttributes="Bold" TextColor="#2C3E50" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Ad" FontSize="11" TextColor="#6C757D" Margin="4,0,0,0" />
                            <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" HeightRequest="46" Padding="15,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Entry x:Name="NameEntry" FontSize="13" TextColor="#1F2937" VerticalOptions="Center" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Soyad" FontSize="11" TextColor="#6C757D" Margin="4,0,0,0" />
                            <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" HeightRequest="46" Padding="15,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Entry x:Name="SurnameEntry" FontSize="13" TextColor="#1F2937" VerticalOptions="Center" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="E-posta" FontSize="11" TextColor="#6C757D" Margin="4,0,0,0" />
                            <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" HeightRequest="46" Padding="15,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Entry x:Name="EmailEntry" FontSize="13" TextColor="#1F2937" Keyboard="Email" VerticalOptions="Center" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="Bilgileri Güncelle" BackgroundColor="#D4AF37" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="46" Clicked="OnUpdateProfileClicked" Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- ŞİFRE DEĞİŞTİRME KARTI -->
                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#D4AF37" Opacity="0.05" Radius="15" Offset="0,5"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Şifre Değiştir" FontSize="14" FontAttributes="Bold" TextColor="#2C3E50" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Mevcut Şifre" FontSize="11" TextColor="#6C757D" Margin="4,0,0,0" />
                            <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" HeightRequest="46" Padding="15,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Entry x:Name="OldPasswordEntry" IsPassword="True" FontSize="13" TextColor="#1F2937" VerticalOptions="Center" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Yeni Şifre" FontSize="11" TextColor="#6C757D" Margin="4,0,0,0" />
                            <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" HeightRequest="46" Padding="15,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Entry x:Name="NewPasswordEntry" IsPassword="True" FontSize="13" TextColor="#1F2937" VerticalOptions="Center" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="Şifreyi Güncelle" BackgroundColor="#4B5563" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="46" Clicked="OnUpdatePasswordClicked" Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- YENİ: Bilgiler kaydedilirken/yüklenirken gösterilen yükleme ekranı -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#33000000" IsVisible="False">
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="30,25"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="220">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1F2937" Opacity="0.25" Radius="20" Offset="0,8" />
                </Border.Shadow>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="14">
                    <ActivityIndicator IsRunning="True" Color="#D4AF37" WidthRequest="40" HeightRequest="40" />
                    <Label Text="Lütfen bekleyiniz"
                           TextColor="#2C3E50"
                           FontAttributes="Bold"
                           FontSize="15"
                           HorizontalOptions="Center" />
                    <Label Text="Kaydediliyor..."
                           TextColor="#9CA3AF"
                           FontSize="12"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
