<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LowmiaApp.HistoryPage"
             Shell.NavBarIsVisible="False">

    <!-- SENİN ARKA PLAN RENKLERİN (DOKUNULMADI) -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FDF0F3" Offset="0.0" />
            <GradientStop Color="#FCF5E3" Offset="0.3" />
            <GradientStop Color="#FDF3E8" Offset="0.7" />
            <GradientStop Color="#F9F5FD" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <!-- Dış Grid: overlay'in tüm sayfayı kaplayabilmesi için eklendi -->
    <Grid>

        <!-- ScrollView yerine Grid kullanıyoruz ki liste sorunsuz kaydırılabilsin -->
        <Grid RowDefinitions="Auto, *">

            <!-- ÜST BAŞLIKLAR VE MENÜ (SENİN KODLARIN, DOKUNULMADI) -->
            <VerticalStackLayout Grid.Row="0" Padding="20,40,20,10" Spacing="20">

                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,10">
                    <Border Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#E5E2DA" StrokeThickness="1" Padding="10,6" HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="≡" FontSize="14" TextColor="#C4962B" VerticalOptions="Center"/>
                            <Label Text="Menü" FontSize="12" FontAttributes="Bold" TextColor="#C4962B" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <Label Grid.Column="1" Text="LOWMİA" FontSize="16" FontAttributes="Bold" TextColor="#C4962B" HorizontalOptions="Center" VerticalOptions="Center" CharacterSpacing="1.5" />

                    <Border Grid.Column="2" BackgroundColor="#D4AF37" StrokeThickness="0" Padding="10,6" HorizontalOptions="End">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Label Text="Geçmiş Raporlar" FontSize="12" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0,0,0,10">
                    <Label Text="CİLT ANALİZ RAPORLARINIZ" FontSize="18" FontAttributes="Bold" TextColor="#2C3E50" HorizontalOptions="Center" CharacterSpacing="1" />
                    <Label Text="Geçmişte yaptığınız analizler ve uzman yapay zeka tavsiyeleri" FontSize="12" TextColor="#6C757D" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- ALT KISIM: WEB SİTESİNDEKİ TASARIMA UYGUN DİNAMİK LİSTE -->
            <CollectionView x:Name="HistoryCollectionView" 
                            Grid.Row="1" 
                            SelectionMode="None" 
                            Margin="20,0,20,30">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,15" 
                                BackgroundColor="White" 
                                Stroke="#EAEAEA" 
                                StrokeThickness="1">

                            <!-- YENİ EKLENEN KISIM: Bütün karta tıklama özelliği verdik (Detaya Gider) -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped"/>
                            </Border.GestureRecognizers>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,2" Radius="5" Opacity="0.05" />
                            </Border.Shadow>

                            <Grid Padding="15" ColumnDefinitions="*, Auto">

                                <!-- SOL KISIM: Tarih ve Başlık -->
                                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="📅" FontSize="14" />
                                        <Label Text="{Binding DateText}" FontSize="14" FontAttributes="Bold" TextColor="#C4962B" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Title}" FontSize="13" TextColor="#7D7D7D" FontAttributes="Italic" />
                                </VerticalStackLayout>

                                <!-- SAĞ KISIM: 3 Nokta Butonu (Sadece Silme Menüsü İçin) -->
                                <!-- Unicode &#x22EE; karakteri dikey 3 noktayı temsil eder -->
                                <Label Grid.Column="1" 
                                       Text="&#x22EE;" 
                                       FontSize="24" 
                                       TextColor="#7D7D7D" 
                                       VerticalOptions="Center" 
                                       HorizontalOptions="Center" 
                                       Padding="10">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnThreeDotsTapped" />
                                    </Label.GestureRecognizers>
                                </Label>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <!-- YENİ: Liste yüklenirken gösterilen yükleme ekranı -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#33000000" IsVisible="False">
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="30,25"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="220">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1F2937" Opacity="0.25" Radius="20" Offset="0,8" />
                </Border.Shadow>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="14">
                    <ActivityIndicator IsRunning="True" Color="#D4AF37" WidthRequest="40" HeightRequest="40" />
                    <Label Text="Lütfen bekleyiniz"
                           TextColor="#2C3E50"
                           FontAttributes="Bold"
                           FontSize="15"
                           HorizontalOptions="Center" />
                    <Label Text="Raporlar yükleniyor..."
                           TextColor="#9CA3AF"
                           FontSize="12"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
