<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LowmiaApp.ForgotPasswordPage"
             Shell.NavBarIsVisible="False">

    <!-- Pastel Arka Plan -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FDF0F3" Offset="0.0" />
            <GradientStop Color="#FCF5E3" Offset="0.3" />
            <GradientStop Color="#FDF3E8" Offset="0.7" />
            <GradientStop Color="#F9F5FD" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <!-- Dış Grid: overlay'in tüm sayfayı kaplayabilmesi için eklendi -->
    <Grid>

        <ScrollView>
            <VerticalStackLayout VerticalOptions="Center" Padding="20">

                <!-- Beyaz, Gölgeli, Oval Kart -->
                <Border BackgroundColor="#F5FFFFFF" 
                        Stroke="#FFFFFF" 
                        StrokeThickness="1" 
                        HorizontalOptions="Center" 
                        WidthRequest="380"
                        Margin="0,15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#D4AF37" Opacity="0.08" Radius="35" Offset="0,15" />
                    </Border.Shadow>

                    <VerticalStackLayout Padding="35,45" Spacing="15">

                        <!-- Başlık ve Açıklama -->
                        <Label Text="ŞİFRE SIFIRLAMA" FontSize="22" FontAttributes="Bold" CharacterSpacing="1" HorizontalOptions="Center" TextColor="#C4962B" Margin="0,0,0,5" />
                        <Label Text="Hesabınıza kayıtlı e-posta adresini girin, size yeni bir şifre belirlemeniz için bağlantı gönderelim." 
                               FontSize="14" 
                               HorizontalOptions="Center" 
                               HorizontalTextAlignment="Center"
                               TextColor="#6C757D" 
                               Margin="0,-5,0,20" />

                        <!-- E-posta Girişi -->
                        <Border Stroke="#F3E8FF" StrokeThickness="1" BackgroundColor="White" HeightRequest="55" Padding="18,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Entry x:Name="EmailEntry" Placeholder="Kayıtlı E-posta Adresiniz" BackgroundColor="Transparent" TextColor="#2C3E50" PlaceholderColor="#9CA3AF" VerticalOptions="Center" Keyboard="Email" />
                        </Border>

                        <!-- Bağlantı Gönder Butonu -->
                        <Border StrokeThickness="0" HeightRequest="55" Margin="0,15,0,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#D4AF37" Offset="0.0" />
                                    <GradientStop Color="#C4962B" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Button Text="BAĞLANTI GÖNDER" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" FontSize="15" CharacterSpacing="0.5" Clicked="OnSendLinkClicked" />
                        </Border>

                        <!-- İptal / Geri Dönüş Linki -->
                        <Label Text="Vazgeç, giriş ekranına dön" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackToLoginTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- YENİ: Bağlantı gönderilirken gösterilen yükleme ekranı -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#66000000" IsVisible="False">
            <Border BackgroundColor="White" HorizontalOptions="Center" VerticalOptions="Center" Padding="30,25" WidthRequest="280">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Radius="20" Offset="0,5" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True" Color="#C4962B" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" />
                    <Label Text="Bağlantı gönderiliyor, lütfen bekleyin..." TextColor="#2C3E50" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
