<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LowmiaApp.HomePage"
             Shell.NavBarIsVisible="True"
             Shell.BackgroundColor="#FDF0F3"
             Shell.TitleColor="#2C3E50">

    <Shell.TitleView>
        <Label Text="Menü" 
               FontSize="16" 
               FontAttributes="Bold" 
               TextColor="#2C3E50" 
               VerticalOptions="Center" />
    </Shell.TitleView>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FDF0F3" Offset="0.0" />
            <GradientStop Color="#FCF5E3" Offset="0.3" />
            <GradientStop Color="#FDF3E8" Offset="0.7" />
            <GradientStop Color="#F9F5FD" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <!-- Ana İçerik ScrollView -->
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20" Margin="0,0,0,20">

                <!-- Üst Kısım: Tarih, Karşılama ve Profil -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,20,0,0">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label x:Name="DateLabel" Text="28 Temmuz" FontSize="13" FontAttributes="Bold" TextColor="#9CA3AF" />
                        <Label Text="Merhaba," FontSize="16" TextColor="#6C757D" />
                        <Label x:Name="UserNameLabel" Text="Kullanıcı" FontSize="22" FontAttributes="Bold" TextColor="#C4962B" />
                    </VerticalStackLayout>

                    <!-- PROFİL FOTOĞRAFI -->
                    <Border Grid.Column="1" WidthRequest="50" HeightRequest="50" BackgroundColor="White" Stroke="#FCE8C7" StrokeThickness="2" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfilePhotoTapped" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Label x:Name="ProfileEmojiLabel" Text="👤" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Image x:Name="ProfileImage" Aspect="AspectFill" WidthRequest="50" HeightRequest="50" IsVisible="False" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Yapay Zeka ile Analiz Kartı -->
                <Border BackgroundColor="#D4AF37" StrokeThickness="0" Padding="25">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Yapay Zeka ile Analiz" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Cildinin güncel durumunu öğrenmek ve sana özel bakım rutini oluşturmak için hemen bir tarama yap." FontSize="13" TextColor="#FFF5E6" />

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Button Text="📷 Kamerayı Aç" BackgroundColor="White" TextColor="#C4962B" FontAttributes="Bold" CornerRadius="16" HeightRequest="45" Padding="15,0" Clicked="OnOpenCameraClicked" />
                            <Button Text="📁 Fotoğraf Yükle" BackgroundColor="White" TextColor="#C4962B" FontAttributes="Bold" CornerRadius="16" HeightRequest="45" Padding="15,0" Clicked="OnUploadFileClicked" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- İstatistikler / Kartlar -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                    <Border Grid.Column="0" BackgroundColor="White" Stroke="#F3E8FF" StrokeThickness="1" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMoistureTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="💧" FontSize="24" />
                            <Label Text="Nem Oranı" FontSize="14" FontAttributes="Bold" TextColor="#2C3E50" />
                            <Label x:Name="MoistureValueLabel" Text="Henüz analiz yok" FontSize="12" TextColor="#6C757D" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="White" Stroke="#F3E8FF" StrokeThickness="1" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnUvTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="☀️" FontSize="24" />
                            <Label Text="UV İndeksi" FontSize="14" FontAttributes="Bold" TextColor="#2C3E50" />
                            <Label Text="Güneş kremi sür" FontSize="12" TextColor="#6C757D" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- GÜNÜN DOĞRU / YANLIŞ BİLGİSİ KARTI -->
                <Border BackgroundColor="White" Stroke="#F3E8FF" StrokeThickness="1" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#1F2937" Opacity="0.05" Radius="15" Offset="0,4"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="💡" FontSize="18"/>
                            <Label Text="Günün Cilt Testi (Doğru / Yanlış)" FontAttributes="Bold" TextColor="#A97C11" FontSize="14" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Label x:Name="TipLabel" 
                               Text="Güneş kremini sadece yazın, bulutlu ve kapalı havalarda sürmesek de olur." 
                               TextColor="#374151" 
                               FontSize="13"
                               LineBreakMode="WordWrap"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,5,0,0">
                            <Button Grid.Column="0" 
                                    Text="DOĞRU" 
                                    BackgroundColor="#16A34A" 
                                    TextColor="#FDF0F3" 
                                    FontAttributes="Bold" 
                                    CornerRadius="10" 
                                    HeightRequest="40"
                                    Clicked="OnTrueAnswerClicked"/>

                            <Button Grid.Column="1" 
                                    Text="YANLIŞ" 
                                    BackgroundColor="#DC2626" 
                                    TextColor="#FDF3E8" 
                                    FontAttributes="Bold" 
                                    CornerRadius="10" 
                                    HeightRequest="40"
                                    Clicked="OnFalseAnswerClicked"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Yükleme Ekranı Overlay -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#33000000" IsVisible="False">
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="30,25"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="220">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1F2937" Opacity="0.25" Radius="20" Offset="0,8" />
                </Border.Shadow>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="14">
                    <ActivityIndicator IsRunning="True" Color="#D4AF37" WidthRequest="40" HeightRequest="40" />
                    <Label Text="Lütfen bekleyiniz"
                           TextColor="#2C3E50"
                           FontAttributes="Bold"
                           FontSize="15"
                           HorizontalOptions="Center" />
                    <Label Text="Analiz ediliyor..."
                           TextColor="#9CA3AF"
                           FontSize="12"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>