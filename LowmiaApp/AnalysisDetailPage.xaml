<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LowmiaApp.AnalysisDetailPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FDF0F3" Offset="0.0" />
            <GradientStop Color="#FCF5E3" Offset="0.3" />
            <GradientStop Color="#FDF3E8" Offset="0.7" />
            <GradientStop Color="#F9F5FD" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,40,20,30" Spacing="20">

                <!-- ÜST BAR: Geri Butonu ve Başlık -->
                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,10">
                    <Border Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#E5E2DA" StrokeThickness="1" Padding="15,6" HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackClicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="←" FontSize="14" FontAttributes="Bold" TextColor="#C4962B" VerticalOptions="Center"/>
                            <Label Text="Geri" FontSize="12" FontAttributes="Bold" TextColor="#C4962B" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <Label Grid.Column="1" Text="ANALİZ DETAYI" FontSize="18" FontAttributes="None" TextColor="#C4962B" HorizontalOptions="Center" VerticalOptions="Center" CharacterSpacing="4" />
                </Grid>

                <!-- ANALİZ KARTININ TAMAMI -->
                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#D4AF37" Opacity="0.1" Radius="20" Offset="0,8"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">

                        <Grid ColumnDefinitions="Auto, *">
                            <Label x:Name="DateLabel" Grid.Column="0" Text="📅 Tarih" FontSize="12" FontAttributes="Bold" TextColor="#C4962B" VerticalOptions="Center" />

                            <HorizontalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                <Border BackgroundColor="#FDF2F8" Stroke="#FBCFE8" StrokeThickness="1" Padding="6,2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Label x:Name="SkinAgeLabel" Text="Cilt Yaşı: -" FontSize="10" FontAttributes="Bold" TextColor="#DB2777" />
                                </Border>
                                <Border BackgroundColor="#EFF6FF" Stroke="#BFDBFE" StrokeThickness="1" Padding="6,2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Label x:Name="UndertoneLabel" Text="Undertone: -" FontSize="10" FontAttributes="Bold" TextColor="#2563EB" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                        <Border BackgroundColor="#F0FDF4" Stroke="#DCFCE7" StrokeThickness="1" Padding="8,4" HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label x:Name="ImprovementLabel" Text="📈 Gelişim: -" FontSize="11" FontAttributes="Bold" TextColor="#16A34A" HorizontalOptions="Center" />
                        </Border>

                        <HorizontalStackLayout Spacing="10" Margin="0,5">
                            <Border WidthRequest="55" HeightRequest="55" Stroke="#E5E2DA" StrokeThickness="1" BackgroundColor="#F9F8F5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Image x:Name="AnalyzedImage" Source="camera_icon.png" Aspect="AspectFill" WidthRequest="55" HeightRequest="55" />
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="KULLANICI NOTU" FontSize="9" TextColor="#9CA3AF" FontAttributes="Bold" />
                                <Label Text="“Genel Cilt Analizi”" FontSize="14" FontAttributes="Bold" TextColor="#2C3E50" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1" Color="#F3E4E6" Margin="0,5" />

                        <!-- SKOR BARLARI -->
                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="15" RowSpacing="15">
                            <!-- Akne Skoru (Sol Üst) -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Akne Skoru" FontSize="11" TextColor="#6C757D" />
                                    <Label x:Name="AcneScoreLabel" Grid.Column="1" Text="-/100" FontSize="11" FontAttributes="Bold" TextColor="#2C3E50" />
                                </Grid>
                                <ProgressBar x:Name="AcneProgressBar" Progress="0" ProgressColor="#DB2777" HeightRequest="6" BackgroundColor="#F3E4E6" />
                            </VerticalStackLayout>

                            <!-- Leke Skoru (Sağ Üst) -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Leke Skoru" FontSize="11" TextColor="#6C757D" />
                                    <Label x:Name="SpotScoreLabel" Grid.Column="1" Text="-/100" FontSize="11" FontAttributes="Bold" TextColor="#2C3E50" />
                                </Grid>
                                <ProgressBar x:Name="SpotProgressBar" Progress="0" ProgressColor="#D97706" HeightRequest="6" BackgroundColor="#F3E4E6" />
                            </VerticalStackLayout>

                            <!-- Nem Dengesi (Sol Alt) -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Nem Dengesi" FontSize="11" TextColor="#6C757D" />
                                    <Label x:Name="MoistureScoreLabel" Grid.Column="1" Text="-/100" FontSize="11" FontAttributes="Bold" TextColor="#2C3E50" />
                                </Grid>
                                <ProgressBar x:Name="MoistureProgressBar" Progress="0" ProgressColor="#16A34A" HeightRequest="6" BackgroundColor="#F3E4E6" />
                            </VerticalStackLayout>

                            <!-- Kırışıklık (Sağ Alt) -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Kırışıklık" FontSize="11" TextColor="#6C757D" />
                                    <Label x:Name="WrinkleScoreLabel" Grid.Column="1" Text="-/100" FontSize="11" FontAttributes="Bold" TextColor="#2C3E50" />
                                </Grid>
                                <ProgressBar x:Name="WrinkleProgressBar" Progress="0" ProgressColor="#2563EB" HeightRequest="6" BackgroundColor="#F3E4E6" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- YAPAY ZEKA YORUMU -->
                        <Border BackgroundColor="#FFF1F2" Stroke="#FFE4E6" StrokeThickness="1" Padding="12" Margin="0,5">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="✨" FontSize="14" />
                                    <Label Text="Lowmia Dermatolog Yorumu" FontSize="13" FontAttributes="Bold" TextColor="#BE123C" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label x:Name="CommentLabel" Text="Analiz sonucu bekleniyor..." FontSize="11" TextColor="#4B5563" LineHeight="1.2" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- SORU-CEVAP KISMI -->
                        <VerticalStackLayout x:Name="QnALayout" Spacing="10" />

                        <Border x:Name="QuestionInputContainer" BackgroundColor="#F9F8F5" Stroke="#E5E2DA" StrokeThickness="1" Padding="15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label x:Name="QuestionLimitLabel" Text="💬 Bu Rapor Hakkında Uzmana Soru Sor (Kalan Hak: 3)" FontSize="12" FontAttributes="Bold" TextColor="#B8860B" />
                                <Border BackgroundColor="White" Stroke="#E5E2DA" StrokeThickness="1" HeightRequest="42" Padding="12,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Entry x:Name="QuestionEntry" Placeholder="Örn: Cildimdeki kızarıklığı yatıştırmak için..." FontSize="11" TextColor="#1F2937" PlaceholderColor="#9CA3AF" VerticalOptions="Center" />
                                </Border>
                                <Button Text="Soruyu Gönder ✈" BackgroundColor="#D4AF37" TextColor="White" FontAttributes="Bold" FontSize="12" CornerRadius="10" HeightRequest="42" Clicked="OnSendQuestionClicked" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- YENİ: Analiz detayı yüklenirken / soru gönderilirken gösterilen yükleme ekranı -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#33000000" IsVisible="False">
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="30,25"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="220">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1F2937" Opacity="0.25" Radius="20" Offset="0,8" />
                </Border.Shadow>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="14">
                    <ActivityIndicator IsRunning="True" Color="#D4AF37" WidthRequest="40" HeightRequest="40" />
                    <Label Text="Lütfen bekleyiniz"
                           TextColor="#2C3E50"
                           FontAttributes="Bold"
                           FontSize="15"
                           HorizontalOptions="Center" />
                    <Label Text="Yükleniyor..."
                           TextColor="#9CA3AF"
                           FontSize="12"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
