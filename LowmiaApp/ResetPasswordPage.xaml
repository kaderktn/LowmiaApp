<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LowmiaApp.ResetPasswordPage"
             Shell.NavBarIsVisible="False">

    <!-- CSS'teki 3'lü Radial Gradient'in MAUI Linear Karşılığı -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FDF9EE" Offset="0.0" />
            <!-- Altın/Sarı yansıması -->
            <GradientStop Color="#F6F0FE" Offset="0.5" />
            <!-- Mor yansıması -->
            <GradientStop Color="#EBF8FE" Offset="1.0" />
            <!-- Mavi yansıması -->
        </LinearGradientBrush>
    </ContentPage.Background>

    <!-- Dış Grid: overlay'in tüm sayfayı kaplayabilmesi için eklendi -->
    <Grid>

        <ScrollView>
            <VerticalStackLayout VerticalOptions="Center" Padding="20">

                <!-- Beyaz Kart (.kart) -->
                <Border BackgroundColor="#FFFFFF" 
                        Stroke="#2ED4AF37" 
                        StrokeThickness="1.5" 
                        HorizontalOptions="Center" 
                        WidthRequest="380"
                        Margin="0,15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#B48C28" Opacity="0.10" Radius="48" Offset="0,8" />
                    </Border.Shadow>

                    <VerticalStackLayout Padding="32,36" Spacing="15">

                        <!-- Logo Daire (.logo-daire) -->
                        <Border WidthRequest="64" 
                                HeightRequest="64" 
                                Stroke="#33D4AF37"
                                StrokeThickness="2"
                                HorizontalOptions="Center"
                                Padding="0"
                                Margin="0,0,0,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="32" />
                            </Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F3F1EC" Offset="0.0" />
                                    <GradientStop Color="#EDE8E0" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Label Text="LM" TextColor="#B8860B" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <!-- Başlıklar -->
                        <Label Text="LOWMİA" FontSize="26" FontAttributes="Bold" CharacterSpacing="1.5" HorizontalOptions="Center" TextColor="#B8860B" Margin="0,0,0,0" />
                        <Label Text="🔒 Yeni şifrenizi belirleyin" FontSize="13" HorizontalOptions="Center" TextColor="#6C757D" Margin="0,0,0,15" />

                        <!-- Yeni Şifre Girişi -->
                        <VerticalStackLayout Spacing="5" Margin="0,0,0,5">
                            <Label Text="Yeni Şifre" TextColor="#374151" FontSize="13" FontAttributes="Bold" Margin="5,0,0,0" />
                            <Border Stroke="#E5E2DA" StrokeThickness="1.5" BackgroundColor="#F9F8F5" HeightRequest="50" Padding="16,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto">
                                    <Entry x:Name="NewPasswordEntry" Grid.Column="0" Placeholder="En az 6 karakter" IsPassword="True" BackgroundColor="Transparent" TextColor="#1F2937" PlaceholderColor="#9CA3AF" VerticalOptions="Center" />
                                    <Label x:Name="NewPasswordEyeIcon" Grid.Column="1" Text="👁" TextColor="#9CA3AF" VerticalOptions="Center" FontSize="18">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnToggleNewPasswordVisibility" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Yeni Şifre Tekrar Girişi -->
                        <VerticalStackLayout Spacing="5" Margin="0,0,0,15">
                            <Label Text="Yeni Şifre (Tekrar)" TextColor="#374151" FontSize="13" FontAttributes="Bold" Margin="5,0,0,0" />
                            <Border Stroke="#E5E2DA" StrokeThickness="1.5" BackgroundColor="#F9F8F5" HeightRequest="50" Padding="16,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto">
                                    <Entry x:Name="ConfirmPasswordEntry" Grid.Column="0" Placeholder="Şifreyi tekrar girin" IsPassword="True" BackgroundColor="Transparent" TextColor="#1F2937" PlaceholderColor="#9CA3AF" VerticalOptions="Center" />
                                    <Label x:Name="ConfirmPasswordEyeIcon" Grid.Column="1" Text="👁" TextColor="#9CA3AF" VerticalOptions="Center" FontSize="18">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnToggleConfirmPasswordVisibility" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Kaydet Butonu (.btn-kaydet) -->
                        <Border StrokeThickness="0" HeightRequest="50" Margin="0,5,0,15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#D4AF37" Offset="0.0" />
                                    <GradientStop Color="#C9A227" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#D4AF37" Opacity="0.3" Radius="16" Offset="0,4" />
                            </Border.Shadow>
                            <Button Text="ŞİFREMİ GÜNCELLE" BackgroundColor="Transparent" TextColor="#1F2937" FontAttributes="Bold" FontSize="14" Clicked="OnUpdatePasswordClicked" />
                        </Border>

                        <!-- Giriş Sayfasına Dön Linki -->
                        <Label Text="⬅ Giriş sayfasına dön" TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackToLoginTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- YENİ: Şifre güncellenirken gösterilen yükleme ekranı -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#66000000" IsVisible="False">
            <Border BackgroundColor="White" HorizontalOptions="Center" VerticalOptions="Center" Padding="30,25" WidthRequest="280">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Radius="20" Offset="0,5" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True" Color="#C4962B" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" />
                    <Label Text="Şifreniz güncelleniyor, lütfen bekleyin..." TextColor="#2C3E50" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
