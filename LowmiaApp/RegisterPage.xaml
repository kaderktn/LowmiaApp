<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LowmiaApp.RegisterPage"
             Shell.NavBarIsVisible="False">

    <!-- Giriş Sayfasındaki Aynı Pastel Arka Plan -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FDF0F3" Offset="0.0" />
            <GradientStop Color="#FCF5E3" Offset="0.3" />
            <GradientStop Color="#FDF3E8" Offset="0.7" />
            <GradientStop Color="#F9F5FD" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView>
            <VerticalStackLayout VerticalOptions="Center" Padding="20">

                <!-- Beyaz, Gölgeli, Oval Kart -->
                <Border BackgroundColor="#F5FFFFFF" 
                        Stroke="#FFFFFF" 
                        StrokeThickness="1" 
                        HorizontalOptions="Center" 
                        WidthRequest="380"
                        Margin="0,15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#D4AF37" Opacity="0.08" Radius="35" Offset="0,15" />
                    </Border.Shadow>

                    <VerticalStackLayout Padding="35,45" Spacing="15">

                        <!-- Başlıklar -->
                        <Label Text="LOWMİA'YA KATIL" FontSize="26" FontAttributes="Bold" CharacterSpacing="1" HorizontalOptions="Center" TextColor="#C4962B" Margin="0,0,0,5" />
                        <Label Text="Yapay zeka ile cilt analizine başla." FontSize="14" HorizontalOptions="Center" TextColor="#6C757D" Margin="0,-10,0,20" />

                        <!-- Ad ve Soyad Yan Yana (Grid ile) -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Border Grid.Column="0" Stroke="#F3E8FF" StrokeThickness="1" BackgroundColor="White" HeightRequest="55" Padding="15,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Entry x:Name="NameEntry" Placeholder="Ad" BackgroundColor="Transparent" TextColor="#2C3E50" PlaceholderColor="#9CA3AF" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Column="1" Stroke="#F3E8FF" StrokeThickness="1" BackgroundColor="White" HeightRequest="55" Padding="15,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Entry x:Name="SurnameEntry" Placeholder="Soyad" BackgroundColor="Transparent" TextColor="#2C3E50" PlaceholderColor="#9CA3AF" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- E-posta -->
                        <Border Stroke="#F3E8FF" StrokeThickness="1" BackgroundColor="White" HeightRequest="55" Padding="18,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Entry x:Name="EmailEntry" Placeholder="E-posta Adresiniz" BackgroundColor="Transparent" TextColor="#2C3E50" PlaceholderColor="#9CA3AF" VerticalOptions="Center" Keyboard="Email" />
                        </Border>

                        <!-- Şifre -->
                        <Border Stroke="#F3E8FF" StrokeThickness="1" BackgroundColor="White" HeightRequest="55" Padding="18,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry x:Name="PasswordEntry" Grid.Column="0" Placeholder="Şifre Oluşturun" IsPassword="True" BackgroundColor="Transparent" TextColor="#2C3E50" PlaceholderColor="#9CA3AF" VerticalOptions="Center" />
                                <Label x:Name="PasswordEyeIcon" Grid.Column="1" Text="👁" TextColor="#9CA3AF" VerticalOptions="Center" FontSize="18">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTogglePasswordVisibility" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>

                        <!-- Şifre Tekrar -->
                        <Border Stroke="#F3E8FF" StrokeThickness="1" BackgroundColor="White" HeightRequest="55" Padding="18,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry x:Name="ConfirmPasswordEntry" Grid.Column="0" Placeholder="Şifreyi Tekrar Girin" IsPassword="True" BackgroundColor="Transparent" TextColor="#2C3E50" PlaceholderColor="#9CA3AF" VerticalOptions="Center" />
                                <Label x:Name="ConfirmPasswordEyeIcon" Grid.Column="1" Text="👁" TextColor="#9CA3AF" VerticalOptions="Center" FontSize="18">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToggleConfirmPasswordVisibility" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>

                        <!-- Kayıt Butonu -->
                        <Border StrokeThickness="0" HeightRequest="55" Margin="0,15,0,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#D4AF37" Offset="0.0" />
                                    <GradientStop Color="#C4962B" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Button Text="KAYIT OL" BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" FontSize="16" CharacterSpacing="0.5" Clicked="OnRegisterClicked" />
                        </Border>

                        <!-- Giriş Yap Linki (Geri Dönüş) -->
                        <Label Text="Zaten hesabınız var mı? Giriş yapın." TextColor="#9CA3AF" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLoginTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- YENİ: Kayıt işlemi sırasında gösterilen yükleme ekranı -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#33000000" IsVisible="False">
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="30,25"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="220">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1F2937" Opacity="0.25" Radius="20" Offset="0,8" />
                </Border.Shadow>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="14">
                    <ActivityIndicator IsRunning="True" Color="#D4AF37" WidthRequest="40" HeightRequest="40" />
                    <Label Text="Lütfen bekleyiniz"
                           TextColor="#2C3E50"
                           FontAttributes="Bold"
                           FontSize="15"
                           HorizontalOptions="Center" />
                    <Label Text="Kayıt oluşturuluyor..."
                           TextColor="#9CA3AF"
                           FontSize="12"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
